{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // The runtime is node's native type-stripping (no build step, no tsx):
    // tsc is a type CHECKER here, never an emitter. Relative imports carry
    // explicit .ts extensions (ESM resolution does not guess extensions);
    // erasableSyntaxOnly guards against syntax (enums, namespaces,
    // parameter properties) that type-stripping cannot erase; and
    // verbatimModuleSyntax forces type-only imports to say `import type`,
    // because the stripper keeps plain imports verbatim and a type imported
    // as a value binding fails at runtime with "does not provide an export".
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // The projection invariant suite (src/v2/projection-invariants.test.ts)
    // imports the site's shared query core (site/browser-query.js) so it runs the
    // EXACT SQL the surfaces build, not a copy that could drift. allowJs lets
    // this program read that JSDoc-annotated module's real signatures; checkJs
    // is on for the same reason it now is in tsconfig.site.json - every site/
    // module #530 brought under checking is clean, so this program's one
    // incidental .js dependency is checked too rather than left as a blind spot.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
