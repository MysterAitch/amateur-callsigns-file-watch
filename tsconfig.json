{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // The runtime is node's native type-stripping (no build step, no tsx):
    // tsc is a type CHECKER here, never an emitter. Relative imports carry
    // explicit .ts extensions (ESM resolution does not guess extensions);
    // erasableSyntaxOnly guards against syntax (enums, namespaces,
    // parameter properties) that type-stripping cannot erase; and
    // verbatimModuleSyntax forces type-only imports to say `import type`,
    // because the stripper keeps plain imports verbatim and a type imported
    // as a value binding fails at runtime with "does not provide an export".
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // The projection parity suite (src/v2/projection-parity.test.ts) imports
    // the site's shared query core (site/browser-query.js) so it runs the
    // EXACT SQL the surfaces build, not a copy that could drift. allowJs lets
    // this program read that JSDoc-annotated module's real signatures;
    // checkJs stays off exactly as in tsconfig.site.json (modules opt in
    // per-file via @ts-check, #530).
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
