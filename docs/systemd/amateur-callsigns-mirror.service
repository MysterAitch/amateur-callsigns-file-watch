[Unit]
Description=Ofcom amateur callsigns mirror - single tick
Documentation=https://github.com/MysterAitch/amateur-callsigns-file-watch
# Don't try to run if the network is not up (typical LXC startup order)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Where you cloned the repo on the LXC. Replace with the actual path.
WorkingDirectory=/opt/amateur-callsigns-file-watch
# Run as a dedicated non-root user. Create first:
#     useradd --system --create-home --home-dir /home/callsign-data-mirror \
#             --shell /usr/sbin/nologin callsign-data-mirror
User=callsign-data-mirror
Group=callsign-data-mirror
# npm resolves tsx from node_modules/.bin. If node/npm are elsewhere on
# the LXC, use their full paths.
ExecStart=/usr/bin/npm run scheduled
# The runner's decision function decides whether to actually do work each
# tick; a systemd fire that results in a "not within any scheduled window"
# skip is normal and expected. Success/no-op is the same exit-0 either way.
StandardOutput=journal
StandardError=journal
# Never restart on failure - the state file + next timer tick is the
# recovery mechanism. Restarting inside a bad publication would just spam.
Restart=no
# Modest hardening - the service only needs to read/write its working dir.
# On Debian 13 (systemd 257), these directives require nesting to be enabled
# on the LXC; the unit will start but hardening may not fully apply without it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/amateur-callsigns-file-watch
# Isolated per-invocation /tmp. Required by tsx (it creates an IPC pipe under
# /tmp/tsx-{uid}/{pid}.pipe to coordinate its wrapper and the Node child).
# PrivateTmp gives the service a writable /tmp that no other process on the
# host can see - better than adding /tmp to ReadWritePaths.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
