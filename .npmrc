# Do not run install scripts for any package by default.
#
# Rationale: npm postinstall scripts execute BEFORE any code review pass and
# have been a repeated supply-chain attack vector (event-stream, ua-parser-js,
# colors.js, ongoing NPM package hijackings). Even trusted-maintainer packages
# can be compromised via credential theft. With ignore-scripts=true, any
# package that genuinely needs its script fails loudly rather than executing
# arbitrary code silently on install.
#
# esbuild (via tsx) uses optionalDependencies to ship the correct
# platform-native binary, which works without needing the postinstall on
# npm 7+. If a future dependency truly requires its install script:
#   1. Investigate what the script does
#   2. Decide whether the risk is acceptable
#   3. Run once explicitly with `npm install --foreground-scripts <pkg>`
#      or `npm rebuild <pkg>` after the initial install
# rather than granting blanket permission.
#
# See project memory `project_supply_chain_posture.md` for the full policy.
ignore-scripts=true
