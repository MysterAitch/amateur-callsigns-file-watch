node_modules/
.idea/
.claude/
dist/
ofcom_page.html
.env

# Scheduled-run state (per-host; not shared)
.notify-state.json

# Vitest coverage output (local + CI runs; never committed)
coverage/

# Locally bootstrapped DuckDB CLI (npm run setup:duckdb); CI installs its own.
.duckdb/

# Local-only drop zone for pre-ingestion source material (see
# docs/source-register.md). NEVER committed: contains WDTK json/html
# save-pages and original attachments, which carry personal-data artefacts
# (requester addresses etc.) and must not be published; only properly
# provenanced bytes graduate into archive/ or reference-data/ via PRs.
landing/

# Deploy build staging (cicd.yaml database cache) - never committed
.dbstage/

# Regeneration diagnostics (resource samples, sweep trace, rusage, post-mortem).
# Written by the CI jobs that regenerate, uploaded as an artifact, never committed.
.diagnostics/

# Builder-facing ledger projection output (build-builder-projection.ts) -
# a build artefact re-derived from the ledger on demand, never committed
_projection/

# Local holdings byte store (issue #618/#619): copies fetched but not yet
# cleared for redistribution. The bytes are NEVER committed; their existence is
# recorded publicly in archive/local-holdings/index.json instead (hash,
# provenance, obtain-from pointer). See archive/local-holdings/README.md.
archive/local-holdings/bytes/

# Default ledger build output (build-ledger.ts with no path argument). The full
# corpus is ~12.7 GiB across 71 files, 33 of which exceed GitHub's 100 MB hard
# limit, so an accidental `git add -A` after a local build must not be able to
# stage it. Ignoring the BUILD directory does not prejudge whether a ledger is
# ever committed (ADR 0024 records that as open) - a committed ledger would live
# at a chosen path, not in build output.
_build/
