# Raw source files - preserve verbatim bytes across platforms. Ofcom (and
# other data sources we'll mirror later) serve CSVs / PDFs / XLSX etc. with
# source-specific bytes; without this marker, git's default text
# normalisation would alter CRLF-terminated CSVs on Windows commit, so the
# LXC checkout would have different bytes than the live download - breaking
# the archive idempotence check that hashes staging CSVs against archived
# raw.csv hashes.
archive/**/raw.*           binary
latest-raw.*               binary
amateur-callsigns-raw.csv  binary

# FOI lane (ADR 0004): data attachments are preserved verbatim under their
# original served filenames, so the whole lane defaults to binary; the text
# artefacts (transcript, meta, derived extracts) are pinned back to LF.
# Derivation convention: raw file -> mechanical extract (raw-extract-*.csv
# for spreadsheets per sheet, raw-extract*.md for PDFs) -> normalised.csv.
archive/foi/**                        binary
# NB: `binary` is a macro for -diff -merge -text, so text artefacts must
# explicitly restore diff+merge as well as text, or PR diffs render them
# as binary blobs.
archive/foi/**/meta.json              text diff merge eol=lf
archive/foi/**/correspondence.md      text diff merge eol=lf
archive/foi/**/raw-extract-*.csv      text diff merge eol=lf
archive/foi/**/raw-extract*.md        text diff merge eol=lf
archive/foi/**/normalised.csv         text diff merge eol=lf
archive/foi/**/normalised--*.csv      text diff merge eol=lf

# Derived normalised.csv must be byte-stable across platforms (meta.json
# records its sha256/size and the sweep no-op check is byte equality) while
# staying diffable text - pin LF, never smudge to CRLF on checkout.
archive/**/normalised.csv text eol=lf
# Open-data lane mechanical extracts (workbook sheet extracts, shape-only
# header fills): hash-declared in meta.json like normalised.csv - pin LF so a
# Windows checkout cannot smudge the bytes away from the declared sha256.
# (The FOI lane pins its raw-extract-*.csv the same way above; meta.json is
# pinned repo-wide as JSON text.)
archive/**/raw-extract*.csv text eol=lf
archive/**/meta.json text eol=lf
# stats.json and quality reports: byte-compared derivatives like normalised.csv
# - pin LF so Windows checkouts cannot break no-op detection or meta hashes.
archive/**/stats.json  text eol=lf
archive/**/components.csv  text eol=lf
reports/**  text eol=lf

# Generated docs with byte-equality freshness tests: pin LF so Windows
# checkouts cannot fail the committed-file-matches-regeneration assertion.
docs/dataset-status.md  text eol=lf
docs/foi-schemas.md  text eol=lf

# Latest-pointer JSON at the repo root: written by serialiseJson (2-space
# indent, trailing LF) and byte-stable by design - validateLatestPointers hashes
# latest-meta.json against the newest entry's meta.json. A Windows checkout that
# smudged these to CRLF would break that hash / no-op detection and churn diffs,
# so pin LF and never smudge to CRLF on checkout.
latest.json                  text eol=lf
latest-raw-sorted.json       text eol=lf
latest-meta.json             text eol=lf
metadata-download-info.json  text eol=lf

# The SCC sweep's committed derived table (issue #693): toCsv/toMetaJson are
# byte-deterministic by design (LF line endings) and the data-validity suite
# reads these back verbatim - pin LF so a Windows checkout cannot smudge them
# to CRLF and break row/notes parsing.
reference-data/rsgb-special-contest-calls.csv        text eol=lf
reference-data/rsgb-special-contest-calls.meta.json  text eol=lf

# Forbidden-suffix rationale (issue #196): generated by
# forbidden-suffix-rationale.ts and read back verbatim by its own
# reproducibility guard (forbidden-suffix-rationale.test.ts) - pin LF for the
# same reason as the SCC table above.
reference-data/forbidden-suffix-rationale.csv  text eol=lf

# Shell scripts run on Linux CI runners: pin LF so a CRLF-normalising
# checkout cannot produce "bad interpreter", and keep them executable.
*.sh text eol=lf
