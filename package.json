{
  "name": "amateur-callsigns-file-watch",
  "version": "1.0.0",
  "description": "",
  "author": "Roger Howell (M7TEE)",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "pull": "tsx src/sources/ofcom-amateur/scrape.ts",
    "process": "tsx src/sources/ofcom-amateur/process.ts",
    "migrate-archive": "tsx src/sources/ofcom-amateur/migrate-archive.ts",
    "scheduled": "tsx src/scheduled-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx src/ci/validate-data.ts",
    "all": "npm run pull && npm run process",
    "js:pull": "node dist/sources/ofcom-amateur/scrape.js",
    "js:process": "node dist/sources/ofcom-amateur/process.js",
    "js:all": "npm run js:pull && npm run js:process"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
