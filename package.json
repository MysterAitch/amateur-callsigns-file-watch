    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
