{
  "name": "amateur-callsigns-file-watch",
  "version": "1.0.0",
  "description": "",
  "author": "Roger Howell (M7TEE)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.site.json",
    "pull": "node src/sources/ofcom-amateur/scrape.ts",
    "process": "node src/sources/ofcom-amateur/process.ts",
    "migrate-archive": "node src/sources/ofcom-amateur/migrate-archive.ts",
    "scheduled": "node src/scheduled-run.ts",
    "setup:duckdb": "node src/tools/setup-duckdb.ts",
    "serve:site": "node src/tools/serve-site.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project fast --tagsFilter \"unit || ui\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "validate:data": "node src/ci/validate-data.ts",
    "normalise:sweep": "node src/ci/normalise-sweep.ts",
    "foi:sweep": "node src/ci/foi-sweep.ts",
    "dataset:status": "node src/ci/dataset-status.ts",
    "foi:schemas": "node src/ci/foi-schemas.ts",
    "labels:pr": "node src/ci/pr-dataset-labels.ts",
    "regen": "npm run normalise:sweep && npm run foi:schemas && npm run dataset:status",
    "all": "npm run pull && npm run process"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "sql.js-httpvfs": "^0.8.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
